# Copy to .env. Without a key the server runs in demo mode with canned estimates.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: API server port (default 8787)
API_PORT=8787

# Private, single-user nutrition export. Generate with: openssl rand -hex 32
# Leave unset to keep the nutrition routes disabled.
NUTRITION_SYNC_TOKEN=
# Store outside dist, on a persistent disk (never commit health data).
NUTRITION_DATA_FILE=./data/nutrition.json
# Exact browser origins allowed to connect; no trailing slash or path.
NUTRITION_ALLOWED_ORIGINS=https://kakdwa.github.io,http://localhost:5173,http://localhost:4173
